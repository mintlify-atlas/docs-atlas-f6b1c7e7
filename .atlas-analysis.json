  "keyFeatures": [
    "Hotel browsing with search and filtering",
    "Room availability checking by date range",
    "Online booking with payment method selection",
    "Invoice generation and management",
    "Role-based access control (client, staff, admin)",
    "Staff management with hotel assignment",
    "Housekeeping and booking management dashboards",
    "Admin reports and analytics",
    "JWT-based authentication with auto token refresh",
    "SQLite database with automatic initialization and sample data"
